# Copy to .env and fill in. Never commit the real .env.

# Server
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed origins for CORS (your Expo web / device URLs)
CORS_ORIGIN=http://localhost:8081,http://localhost:19006

# =========================================================
# DATABASE
# =========================================================
# --- Option A: Supabase (recommended; hosted PostgreSQL) ---
# In Supabase: Project → Connect → "Connection string" → URI.
# Use the SESSION POOLER or DIRECT connection (port 5432) for this long-running
# Express server. Replace [PASSWORD] and [PROJECT-REF]/[REGION] with yours.
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
# DB_SSL=true

# --- Option B: Local PostgreSQL ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/babybook
# DB_SSL=false
# (Or use discrete vars instead of DATABASE_URL)
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=babybook

# Leave DB_SSL unset to auto-detect: SSL on for remote hosts, off for localhost.

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Hours a password-reset token stays valid
RESET_TOKEN_TTL_HOURS=2

# Data-at-rest encryption key for sensitive DB fields (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MUST be identical across every backend sharing the same database, and kept
# stable (changing it makes existing encrypted data unreadable).
DATA_ENCRYPTION_KEY=change-me-to-a-long-random-32-byte-hex-string

# Uploads (local disk). Files are served from /uploads.
UPLOAD_DIR=uploads
# Public base URL used to build absolute photo URLs returned to the app
PUBLIC_URL=http://localhost:4000

# Email (password reset). Leave blank to fall back to a dev token in the response.
# For Gmail: use an App Password (not your normal password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=BabyBook+ <no-reply@babybook.app>
# Where the reset link points (your app's reset screen)
APP_RESET_URL=http://localhost:8081/reset

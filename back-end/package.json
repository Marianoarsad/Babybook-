{
    "name": "babybook-backend",
    "version": "1.0.0",
    "description": "BabyBook+ backend API — Express + PostgreSQL (parent-controlled child health recordkeeping with QR consultation access).",
    "main": "src/server.js",
    "scripts": {
        "start": "node src/server.js",
        "dev": "nodemon src/server.js",
        "db:migrate": "node src/db/migrate.js",
        "db:migrate:up": "node src/db/migrateUp.js",
        "db:seed": "node src/db/seed.js",
        "db:seed:demo": "node src/db/seedDemoYear.js",
        "db:reset": "node src/db/migrate.js && node src/db/seed.js",
        "test": "jest --runInBand"
    },
    "engines": {
        "node": ">=18"
    },
    "dependencies": {
        "@supabase/supabase-js": "^2.45.4",
        "bcryptjs": "^2.4.3",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.19.2",
        "express-validator": "^7.1.0",
        "jsonwebtoken": "^9.0.2",
        "morgan": "^1.10.0",
        "multer": "^1.4.5-lts.1",
        "nodemailer": "^9.0.3",
        "pg": "^8.12.0"
    },
    "devDependencies": {
        "jest": "^29.7.0",
        "nodemon": "^3.1.4",
        "supertest": "^7.0.0"
    }
}

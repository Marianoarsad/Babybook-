# Backend URL used when running `expo start` on this machine.
# Local dev: points at the local backend (cd back-end && npm run dev).
# Uses the machine's LAN IP (not "localhost") so this works from BOTH a
# browser on this machine AND Expo Go on a phone on the same Wi-Fi network —
# "localhost" from the phone's perspective means the phone itself, not this
# computer. Re-run `ipconfig` and update this if the LAN IP ever changes
# (e.g. new Wi-Fi network, DHCP lease renewal).
# For the deployed Render backend instead, use:
#   EXPO_PUBLIC_API_BASE_URL=https://babybook-xi2w.onrender.com
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000

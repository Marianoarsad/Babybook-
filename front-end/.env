# Backend URL used when running `expo start` on this machine.
# Pointed at the LIVE Railway backend so the app reaches the same database
# where the demo account is seeded (no need to run a local backend).
#
# To develop against a LOCAL backend instead, run `cd back-end && npm run dev`
# and change this to http://localhost:4000 (or your LAN IP on a real device).
EXPO_PUBLIC_API_BASE_URL=https://babybook-production-bc91.up.railway.app

# Local development default. Safe to commit — no secrets, just the
# backend URL used when running `expo start` on this machine.
# Real device on your Wi-Fi (not an emulator)? Replace with your computer's
# LAN IP, e.g. EXPO_PUBLIC_API_BASE_URL=http://192.168.1.20:4000
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000

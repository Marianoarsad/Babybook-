EXPO_PUBLIC_API_BASE_URL=http://localhost:4000

# Google OAuth web client ID. The same client ID is used as the Android ID
# token audience; register com.babybookplus.app and each debug/release SHA-1.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Meta app configuration. FACEBOOK_CLIENT_TOKEN is consumed only by the Expo
# config plugin during a native build; the app ID is also used by the web SDK.
EXPO_PUBLIC_FACEBOOK_APP_ID=
FACEBOOK_CLIENT_TOKEN=
EXPO_PUBLIC_FACEBOOK_GRAPH_VERSION=v23.0

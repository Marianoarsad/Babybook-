{
    "expo": {
        "name": "BabyBook+",
        "slug": "babybook-plus",
        "version": "1.0.0",
        "orientation": "portrait",
        "userInterfaceStyle": "automatic",
        "newArchEnabled": true,
        "scheme": "babybookplus",
        "icon": "./assets/splash-icon.png",
        "ios": {
            "supportsTablet": true,
            "bundleIdentifier": "com.babybookplus.app"
        },
        "android": {
            "package": "com.babybookplus.app",
            "adaptiveIcon": {
                "backgroundColor": "#F2F5F7",
                "foregroundImage": "./assets/splash-icon.png"
            },
            "permissions": ["android.permission.CAMERA"]
        },
        "web": {
            "bundler": "metro",
            "output": "single",
            "favicon": "./assets/splash-icon.png"
        },
        "plugins": [
            "@react-native-community/datetimepicker",
            [
                "expo-image-picker",
                {
                    "photosPermission": "BabyBook+ needs access to your photos so you can set a baby avatar or add photos to memories."
                }
            ],
            [
                "expo-camera",
                {
                    "cameraPermission": "BabyBook+ needs access to your camera to scan consultation QR codes."
                }
            ],
            "expo-sharing",
            [
                "expo-splash-screen",
                {
                    "backgroundColor": "#F2F5F7",
                    "imageWidth": 200,
                    "image": "./assets/splash-icon.png"
                }
            ]
        ],
        "extra": {
            "eas": {
                "projectId": "1e9ae745-f67e-49ad-97ec-48901d82cf6b"
            }
        }
    }
}
